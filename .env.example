# Spring Boot reads exported environment variables, not .env automatically.
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional Docker Compose MySQL (replace these values):
DB_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-another-password
# Export these only when using MySQL:
# DB_URL=jdbc:mysql://localhost:3307/mindbridge?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=mindbridge

# Local demo credentials; override before using outside a synthetic demo.
STUDENT_PASSWORD=student-demo
SECOND_STUDENT_PASSWORD=student2-demo
ADMIN_PASSWORD=admin-demo
EXCEL_PATH=./data/mindbridge-reports.xlsx
